<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

    <xs:element name="Devices">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Device" type="DeviceType"
                            minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


    <xs:simpleType name="DeviceId">
        <xs:restriction base="xs:ID">
            <xs:pattern value="dev-[0-9]{3}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NonEmptyString">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="100"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PriceType">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0"/>
            <xs:fractionDigits value="2"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PowerType">
        <xs:restriction base="xs:int">
            <xs:minInclusive value="0"/>
            <xs:maxInclusive value="2000"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="GroupType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="input-output"/>
            <xs:enumeration value="multimedia"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PortType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="COM"/>
            <xs:enumeration value="USB"/>
            <xs:enumeration value="LPT"/>
        </xs:restriction>
    </xs:simpleType>


    <xs:complexType name="PortsType">
        <xs:sequence>
            <xs:element name="Port" type="PortType" minOccurs="1" maxOccurs="3"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="DeviceParamsType">
        <xs:sequence>
            <xs:element name="Peripheral" type="xs:boolean"/>
            <xs:element name="EnergyConsumption" type="PowerType"/>
            <xs:element name="Cooler" type="xs:boolean"/>
            <xs:element name="Group" type="GroupType"/>
            <xs:element name="Ports" type="PortsType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="DeviceType">
        <xs:sequence>
            <xs:element name="Name" type="NonEmptyString"/>
            <xs:element name="Origin" type="NonEmptyString"/>
            <xs:element name="Price" type="PriceType"/>
            <xs:element name="Type" type="DeviceParamsType"/>
            <xs:element name="Critical" type="xs:boolean"/>
        </xs:sequence>
        <xs:attribute name="id" type="DeviceId" use="required"/>
    </xs:complexType>
</xs:schema>